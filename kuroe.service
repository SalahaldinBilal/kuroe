[Unit]
Description=kuroe deployment server
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
Environment=KUROE_DATA=/var/lib/kuroe
Environment=KUROE_LISTEN=0.0.0.0:27863
ExecStart=/usr/local/bin/kuroe serve
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
